# Copie para .env e preencha com os dados do seu projeto Supabase.
# Sem estes valores o app roda inteiro em modo local (SQLite), sem sincronizar.
#
# Onde achar: Supabase > Project Settings > Data API / API Keys.
# A anon key e publica por design — quem protege os dados e o RLS do
# supabase/schema.sql, que amarra cada linha ao auth.uid() do dono.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
