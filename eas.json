{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "padrao"
    },
    "teste": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "teste"
      },
      "channel": "teste"
    }
  },
  "submit": {
    "production": {}
  }
}
